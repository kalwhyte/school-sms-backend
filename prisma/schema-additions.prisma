// ── ADD TO YOUR EXISTING schema.prisma ────────────────────────────────────────
// Place after the User model

model Student {
  id              String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId          String    @unique @map("user_id") @db.Uuid
  schoolId        String    @map("school_id") @db.Uuid
  currentClassId  String?   @map("current_class_id") @db.Uuid
  fullName        String    @map("full_name")
  admissionNumber String    @map("admission_number")
  dateOfBirth     DateTime  @map("date_of_birth") @db.Date
  gender          Gender
  address         String?
  stateOfOrigin   String?   @map("state_of_origin")
  religion        String?
  photoUrl        String?   @map("photo_url")
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  school       School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  currentClass Class?            @relation("CurrentClass", fields: [currentClassId], references: [id])
  enrollments  ClassEnrollment[]
  parents      ParentStudent[]
  attendance   Attendance[]
  scores       Score[]
  documents    Document[]
  leaveRequests LeaveRequest[]
  homeworkSubmissions HomeworkSubmission[]

  @@unique([schoolId, admissionNumber])
  @@index([schoolId])
  @@index([currentClassId])
  @@index([fullName])
  @@map("students")
}

model ClassEnrollment {
  id                 String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  studentId          String    @map("student_id") @db.Uuid
  classId            String    @map("class_id") @db.Uuid
  enrollmentDate     DateTime  @map("enrollment_date") @db.Date
  status             EnrollmentStatus @default(active)
  finalAverage       Decimal?  @map("final_average") @db.Decimal(5, 2)
  classPosition      Int?      @map("class_position")
  totalStudents      Int?      @map("total_students")
  promotedToClassId  String?   @map("promoted_to_class_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class           Class    @relation(fields: [classId], references: [id])
  promotedToClass Class?   @relation("PromotedTo", fields: [promotedToClassId], references: [id])
  reportCards     ReportCard[]
  scores          Score[]

  @@unique([studentId, classId])
  @@index([classId])
  @@index([studentId])
  @@map("class_enrollments")
}

// ── ENUMS (add to your existing enums block) ──────────────────────────────────

enum Gender {
  male
  female

  @@map("genders")
}

enum EnrollmentStatus {
  active
  transferred
  withdrawn
  completed

  @@map("enrollment_statuses")
}
