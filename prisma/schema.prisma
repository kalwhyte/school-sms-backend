generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters", "postgresqlExtensions"]
  engineType      = "binary"
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_trgm, uuid_ossp(map: "uuid-ossp")]
}

model School {
  id               String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name             String
  address          String
  logoUrl          String?            @map("logo_url")
  schoolCode       String             @unique @map("school_code")
  subscriptionTier SubscriptionTier   @default(free) @map("subscription_tier")
  currency         String             @default("NGN")
  isActive         Boolean            @default(true) @map("is_active")
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?          @map("deleted_at") @db.Timestamptz(6)
  announcements    Announcement[]
  bursaryApprovals BursaryApproval[]
  assignments Assignment[]
  subjectResources SubjectResource[]
  classes          Class[]
  documents        Document[]
  expenseRecords   ExpenseRecord[]
  feeStructures    FeeStructure[]
  leaveRequests    LeaveRequest[]
  messageThreads   MessageThread[]
  notifications    Notification[]
  parents          Parent[]
  payments         Payment[]
  staff            Staff[]
  feeLedgers       StudentFeeLedger[]
  students         Student[]
  subjects         Subject[]
  users            User[]

  @@index([name])
  @@map("schools")
}

model User {
  id                 String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  schoolId           String            @map("school_id") @db.Uuid
  phone              String            @unique
  email              String?           @unique
  password           String?           @map("password_")
  phoneVerifiedAt    DateTime?         @map("phone_verified_at") @db.Timestamptz(6)
  emailVerifiedAt    DateTime?         @map("email_verified_at") @db.Timestamptz(6)
  role               UserRole
  isActive           Boolean           @default(true) @map("is_active")
  lastLogin          DateTime?         @map("last_login") @db.Timestamptz(6)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  announcements      Announcement[]
  createdAssessments Assessment[]
  recordedAttendance Attendance[]
  approvedBursaries  BursaryApproval[]
  createdAssignments Assignment[] @relation("AssignmentCreator")
  uploadedSubjectResources SubjectResource[] @relation("SubjectResourceUploader")
  uploadedDocuments  Document[]
  recordedExpenses   ExpenseRecord[]
  decidedLeaves      LeaveRequest[]    @relation("DecidedBy")
  submittedLeaves    LeaveRequest[]    @relation("SubmittedBy")
  messages           Message[]
  notifications      Notification[]
  parent             Parent?
  pushTokens         PushToken[]
  refreshTokens      RefreshToken[]
  gradedScores       Score[]
  staff              Staff?
  student            Student?
  school             School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([phone])
  @@map("users")
}

model Student {
  id               String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId           String?            @unique @map("user_id") @db.Uuid
  schoolId         String             @map("school_id") @db.Uuid
  admissionNumber  String             @map("admission_number")
  fullName         String             @map("full_name")
  dob              DateTime?          @db.Date
  gender           Gender?
  classId          String?            @map("class_id") @db.Uuid
  guardianName     String?            @map("guardian_name")
  photoUrl         String?            @map("photo_url")
  isActive         Boolean            @default(true) @map("is_active")
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?          @map("deleted_at") @db.Timestamptz(6)
  attendance       Attendance[]
  bursaryApprovals BursaryApproval[]
  enrollments      ClassEnrollment[]
  assignmentSubmissions AssignmentSubmission[]
  documents        Document[]
  leaveRequests    LeaveRequest[]
  messageThreads   MessageThread[]
  parents          ParentStudent[]
  payments         Payment[]
  reportCards      ReportCard[]
  scores           Score[]
  feeLedgers       StudentFeeLedger[]
  currentClass     Class?             @relation("CurrentClass", fields: [classId], references: [id])
  school           School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user             User?              @relation(fields: [userId], references: [id])

  @@unique([schoolId, admissionNumber])
  @@index([schoolId])
  @@index([classId])
  @@map("students")
}

model Parent {
  id             String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId         String          @unique @map("user_id") @db.Uuid
  schoolId       String          @map("school_id") @db.Uuid
  fullName       String          @map("full_name")
  phone          String
  email          String?
  occupation     String?
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  messageThreads MessageThread[]
  students       ParentStudent[]
  school         School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@map("parents")
}

model Staff {
  id               String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId           String          @unique @map("user_id") @db.Uuid
  schoolId         String          @map("school_id") @db.Uuid
  fullName         String          @map("full_name")
  roleTitle        String          @map("role_title")
  subjectSpecialty String?         @map("subject_specialty")
  photoUrl         String?         @map("photo_url")
  isActive         Boolean         @default(true) @map("is_active")
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  managedClasses   Class[]
  messageThreads   MessageThread[]
  school           School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjects         Subject[]

  @@index([schoolId])
  @@map("staff")
}

model ParentStudent {
  id           String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  parentId     String  @map("parent_id") @db.Uuid
  studentId    String  @map("student_id") @db.Uuid
  relationship String  @default("guardian")
  parent       Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student      Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
  @@index([studentId])
  @@map("parent_student")
}

model Class {
  id            String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  schoolId      String            @map("school_id") @db.Uuid
  name          String
  arm           String
  teacherId     String?           @map("teacher_id") @db.Uuid
  academicYear  String            @map("academic_year")
  term          Term
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  level         ClassLevel?
  stream        ClassStream?
  announcements Announcement[]
  attendance    Attendance[]
  enrollments   ClassEnrollment[]
  school        School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classTeacher  Staff?            @relation(fields: [teacherId], references: [id])
  feeStructures FeeStructure[]
  reportCards   ReportCard[]
  students      Student[]         @relation("CurrentClass")
  subjects      Subject[]
  timetable     TimetablePeriod[]

  @@unique([schoolId, name, arm, academicYear, term])
  @@index([schoolId])
  @@map("classes")
}

model ClassEnrollment {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  classId    String   @map("class_id") @db.Uuid
  studentId  String   @map("student_id") @db.Uuid
  enrolledAt DateTime @default(now()) @map("enrolled_at") @db.Timestamptz(6)
  class      Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classId, studentId])
  @@index([classId])
  @@index([studentId])
  @@map("class_enrollments")
}

model Subject {
  id          String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  schoolId    String            @map("school_id") @db.Uuid
  name        String
  classId     String            @map("class_id") @db.Uuid
  isCore      Boolean           @default(true) @map("is_core")
  teacherId   String?           @map("teacher_id") @db.Uuid
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  assessments Assessment[]
  class       Class             @relation(fields: [classId], references: [id], onDelete: Cascade)
  school      School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacher     Staff?            @relation(fields: [teacherId], references: [id])
  timetable   TimetablePeriod[]
  assignments Assignment[]
  resources   SubjectResource[]

  @@unique([classId, name])
  @@index([classId])
  @@index([teacherId])
  @@map("subjects")
}

model TimetablePeriod {
  id        String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  classId   String    @map("class_id") @db.Uuid
  subjectId String    @map("subject_id") @db.Uuid
  dayOfWeek DayOfWeek @map("day_of_week")
  startTime DateTime  @map("start_time") @db.Time(6)
  endTime   DateTime  @map("end_time") @db.Time(6)
  class     Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject   Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@map("timetable_periods")
}

model Attendance {
  id         String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  studentId  String           @map("student_id") @db.Uuid
  classId    String           @map("class_id") @db.Uuid
  date       DateTime         @db.Date
  status     AttendanceStatus
  recordedBy String?          @map("recorded_by") @db.Uuid
  recordedAt DateTime         @default(now()) @map("recorded_at") @db.Timestamptz(6)
  reason     String?          @map("reason")
  class      Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  recorder   User?            @relation(fields: [recordedBy], references: [id])
  student    Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
  @@index([studentId])
  @@index([classId, date])
  @@map("attendance")
}

model Assessment {
  id           String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  subjectId    String         @map("subject_id") @db.Uuid
  title        String
  type         AssessmentType
  maxScore     Decimal        @map("max_score") @db.Decimal
  passingScore Decimal?       @map("passing_score") @db.Decimal
  date         DateTime       @db.Date
  isPublished  Boolean        @default(false) @map("is_published")
  createdBy    String?        @map("created_by") @db.Uuid
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  academicYear String?        @map("academic_year")
  term         Term?
  creator      User?          @relation(fields: [createdBy], references: [id])
  subject      Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  scores       Score[]

  @@index([subjectId])
  @@map("assessments")
}

model Score {
  id           String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  assessmentId String     @map("assessment_id") @db.Uuid
  studentId    String     @map("student_id") @db.Uuid
  score        Decimal    @db.Decimal
  gradedBy     String?    @map("graded_by") @db.Uuid
  gradedAt     DateTime   @default(now()) @map("graded_at") @db.Timestamptz(6)
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  grader       User?      @relation(fields: [gradedBy], references: [id])
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, studentId])
  @@index([assessmentId])
  @@index([studentId])
  @@map("scores")
}

model ReportCard {
  id                    String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  studentId             String    @map("student_id") @db.Uuid
  classId               String    @map("class_id") @db.Uuid
  term                  Term
  academicYear          String    @map("academic_year")
  pdfUrl                String?   @map("pdf_url")
  isPublished           Boolean   @default(false) @map("is_published")
  publishedAt           DateTime? @map("published_at") @db.Timestamptz(6)
  generatedAt           DateTime? @map("generated_at") @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  attendanceDaysAbsent  Int?      @map("attendance_days_absent")
  attendanceDaysPresent Int?      @map("attendance_days_present")
  attendancePercentage  Decimal?  @map("attendance_percentage") @db.Decimal
  averageScore          Decimal?  @map("average_score") @db.Decimal
  classPosition         Int?      @map("class_position")
  classTeacherRemark    String?   @map("class_teacher_remark")
  nextTermBegins        DateTime? @map("next_term_begins") @db.Date
  principalRemark       String?   @map("principal_remark")
  totalScore            Decimal?  @map("total_score") @db.Decimal
  totalStudentsInClass  Int?      @map("total_students_in_class")
  class                 Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  student               Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, term, academicYear])
  @@index([studentId])
  @@map("report_cards")
}

model FeeStructure {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  schoolId     String   @map("school_id") @db.Uuid
  classId      String   @map("class_id") @db.Uuid
  term         Term
  academicYear String   @map("academic_year")
  amount       Decimal  @db.Decimal
  description  String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  class        Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  school       School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([classId, term, academicYear])
  @@index([schoolId])
  @@map("fee_structures")
}

model StudentFeeLedger {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  studentId    String   @map("student_id") @db.Uuid
  schoolId     String   @map("school_id") @db.Uuid
  term         Term
  academicYear String   @map("academic_year")
  totalOwed    Decimal  @default(0) @map("total_owed") @db.Decimal
  totalPaid    Decimal  @default(0) @map("total_paid") @db.Decimal
  balance      Decimal  @default(0) @db.Decimal
  lastUpdated  DateTime @default(now()) @map("last_updated") @db.Timestamptz(6)
  school       School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, term, academicYear])
  @@index([studentId])
  @@map("student_fee_ledger")
}

model Payment {
  id                 String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  studentId          String          @map("student_id") @db.Uuid
  schoolId           String          @map("school_id") @db.Uuid
  amount             Decimal         @db.Decimal
  paystackReference  String?         @unique @map("paystack_reference")
  paystackAccessCode String?         @map("paystack_access_code")
  paymentMethod      String          @default("paystack") @map("payment_method")
  status             PaymentStatus   @default(pending)
  term               Term?
  academicYear       String?         @map("academic_year")
  paidAt             DateTime?       @map("paid_at") @db.Timestamptz(6)
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  receipt            PaymentReceipt?
  school             School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student            Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([schoolId])
  @@index([status])
  @@index([paystackReference])
  @@map("payments")
}

model PaymentReceipt {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  paymentId   String   @unique @map("payment_id") @db.Uuid
  pdfUrl      String   @map("pdf_url")
  generatedAt DateTime @default(now()) @map("generated_at") @db.Timestamptz(6)
  payment     Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@map("payment_receipts")
}

model BursaryApproval {
  id             String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  studentId      String   @map("student_id") @db.Uuid
  schoolId       String   @map("school_id") @db.Uuid
  discountAmount Decimal  @map("discount_amount") @db.Decimal
  reason         String
  approvedBy     String?  @map("approved_by") @db.Uuid
  term           Term?
  academicYear   String?  @map("academic_year")
  approvedAt     DateTime @default(now()) @map("approved_at") @db.Timestamptz(6)
  approver       User?    @relation(fields: [approvedBy], references: [id])
  school         School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("bursary_approvals")
}

model ExpenseRecord {
  id          String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  schoolId    String          @map("school_id") @db.Uuid
  description String
  amount      Decimal         @db.Decimal
  category    ExpenseCategory
  recordedBy  String?         @map("recorded_by") @db.Uuid
  date        DateTime        @db.Date
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  recorder    User?           @relation(fields: [recordedBy], references: [id])
  school      School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, date])
  @@map("expense_records")
}

model Assignment {
  id           String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  schoolId     String    @map("school_id") @db.Uuid
  subjectId    String    @map("subject_id") @db.Uuid
  title        String
  instructions String?   @db.Text
  dueDate      DateTime? @map("due_date") @db.Timestamptz(6)
  attachmentUrl String?  @map("attachment_url")
  isPublished  Boolean   @default(false) @map("is_published")
  createdBy    String?   @map("created_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  school      School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subject     Subject                @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  creator     User?                  @relation("AssignmentCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  submissions AssignmentSubmission[]

  @@index([schoolId, subjectId])
  @@index([subjectId, isPublished])
  @@index([dueDate])
  @@map("assignments")
}

model AssignmentSubmission {
  id           String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  assignmentId String    @map("assignment_id") @db.Uuid
  studentId    String    @map("student_id") @db.Uuid
  fileUrl      String?   @map("file_url")
  answerText   String?   @map("answer_text") @db.Text
  submittedAt  DateTime? @map("submitted_at") @db.Timestamptz(6)
  score        Decimal?  @db.Decimal
  feedback     String?   @db.Text
  gradedAt     DateTime? @map("graded_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@index([studentId])
  @@index([assignmentId, submittedAt])
  @@map("assignment_submissions")
}

model SubjectResource {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  schoolId    String   @map("school_id") @db.Uuid
  subjectId   String   @map("subject_id") @db.Uuid
  title       String
  author      String?
  publisher   String?
  edition     String?
  description String?  @db.Text
  resourceUrl String   @map("resource_url")
  createdBy   String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  school   School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subject  Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  uploader User?   @relation("SubjectResourceUploader", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([schoolId, subjectId])
  @@map("subject_resources")
}

model Announcement {
  id        String               @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  schoolId  String               @map("school_id") @db.Uuid
  authorId  String?              @map("author_id") @db.Uuid
  title     String
  body      String
  audience  AnnouncementAudience
  classId   String?              @map("class_id") @db.Uuid
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  author    User?                @relation(fields: [authorId], references: [id])
  class     Class?               @relation(fields: [classId], references: [id], onDelete: Cascade)
  school    School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, createdAt(sort: Desc)])
  @@map("announcements")
}

model Notification {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  title     String
  body      String
  type      String
  data      Json?
  isSystem  Boolean  @default(false) @map("is_system")
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt(sort: Desc)])
  @@map("notifications")
}

model MessageThread {
  id        String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  schoolId  String    @map("school_id") @db.Uuid
  parentId  String    @map("parent_id") @db.Uuid
  teacherId String    @map("teacher_id") @db.Uuid
  studentId String    @map("student_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  parent    Parent    @relation(fields: [parentId], references: [id], onDelete: Cascade)
  school    School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher   Staff     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@unique([parentId, teacherId, studentId])
  @@index([parentId])
  @@index([teacherId])
  @@map("message_threads")
}

model Message {
  id       String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  threadId String        @map("thread_id") @db.Uuid
  senderId String        @map("sender_id") @db.Uuid
  body     String
  sentAt   DateTime      @default(now()) @map("sent_at") @db.Timestamptz(6)
  readAt   DateTime?     @map("read_at") @db.Timestamptz(6)
  sender   User          @relation(fields: [senderId], references: [id], onDelete: Cascade)
  thread   MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, sentAt(sort: Desc)])
  @@map("messages")
}

model LeaveRequest {
  id           String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  studentId    String      @map("student_id") @db.Uuid
  schoolId     String      @map("school_id") @db.Uuid
  submittedBy  String?     @map("submitted_by") @db.Uuid
  reason       String
  fromDate     DateTime    @map("from_date") @db.Date
  toDate       DateTime    @map("to_date") @db.Date
  status       LeaveStatus @default(pending)
  decisionNote String?     @map("decision_note")
  decidedBy    String?     @map("decided_by") @db.Uuid
  decidedAt    DateTime?   @map("decided_at") @db.Timestamptz(6)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  decider      User?       @relation("DecidedBy", fields: [decidedBy], references: [id])
  school       School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student      Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  submitter    User?       @relation("SubmittedBy", fields: [submittedBy], references: [id])

  @@index([schoolId, status])
  @@map("leave_requests")
}

model Document {
  id         String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  studentId  String       @map("student_id") @db.Uuid
  schoolId   String       @map("school_id") @db.Uuid
  type       DocumentType
  fileUrl    String       @map("file_url")
  filename   String
  uploadedBy String?      @map("uploaded_by") @db.Uuid
  uploadedAt DateTime     @default(now()) @map("uploaded_at") @db.Timestamptz(6)
  school     School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student    Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  uploader   User?        @relation(fields: [uploadedBy], references: [id])

  @@index([studentId])
  @@map("documents")
}

model PushToken {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  platform  Platform
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_tokens")
}

model OtpCode {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  phone      String
  code       String
  schoolCode String   @map("school_code")
  isUsed     Boolean  @default(false) @map("is_used")
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([phone, isUsed, expiresAt])
  @@map("otp_codes")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

